HOME=/home/supabase
SUPABASE_PROJECT_DIR=/srv/supabase/project
SUPABASE_BACKUP_OUTPUT=/var/backups/supabase/local
SUPABASE_BACKUP_MIRROR=/mnt/offsite/supabase
SUPABASE_BACKUP_KEY_FILE=/etc/supabase-backup/mirror.key
SUPABASE_FAILURE_HOOK=/usr/local/libexec/supabase-backup-failed
GNUPGHOME=/var/lib/supabase-backup/gnupg
